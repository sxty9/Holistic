[Unit]
# The setup process. It exists to stop existing: once the instance is claimed
# and configured, the same act that writes the claim marker disables this unit.
# A root-privileged HTTP server bound to a local network is a one-time job, and
# leaving it enabled "just in case" is how the one-time job becomes a permanent
# liability.
Description=Holistic setup
Documentation=https://github.com/sxty9/Holistic
After=network-online.target
Wants=network-online.target

# The guard that makes this a one-time unit. Once @CONF@/claimed exists, this
# unit is skipped even if something enables it — the fact is on disk, owned by
# root, and not a flag inside a process that could read it the wrong way.
ConditionPathExists=!@CONF@/claimed

[Service]
Type=simple
ExecStart=@PREFIX@/bin/holistic-setup -port @PORT@ -claim @CONF@/setup.claim -ledger @STATE@/provisioned.json -seal @CONF@/claimed -web @PREFIX@/setup-web

# Root, and deliberately so. This process writes /etc/corex, /etc/solisuite and
# /etc/warpgate, installs units and starts services — that is what setting up an
# instance IS. The mitigation is not to pretend otherwise with a service account
# that needs a sudo wrapper for every step; it is that the unit is conditional,
# short-lived, and removes itself.
User=root
Group=root

# Binding port 80 needs the capability even as root once NoNewPrivileges is on.
# Nothing else is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true

# Not ProtectSystem=strict: this process configures the machine, so /etc is its
# work. It is narrowed to the directories it has business in rather than opened
# up wholesale.
ProtectSystem=full
ReadWritePaths=@CONF@ @STATE@ /etc/corex /etc/solisuite /etc/warpgate /etc/systemd/system

# The setup process answers on the local network only. This is belt to the
# code's braces: the listener already binds named interfaces rather than
# 0.0.0.0, and refuses requests that did not arrive from a private address.
# NO IPAddressDeny. It was here, allowing only private ranges, and it was
# removed deliberately on 2026-08-30 after it silently broke half the wizard.
#
# systemd's address filter applies in BOTH directions. Confining this unit to
# private ranges did keep the setup page local — and it also stopped the wizard
# from reaching Cloudflare to verify a token or resolve a zone, and from
# fetching its own hostnames from the public internet to prove they answer.
# Every one of those steps failed with "could not reach Cloudflare", which reads
# like a network fault and is a unit file.
#
# What keeps the page local is in the code, and it is stronger than this was:
#
#   lan.Listen binds this machine's LAN addresses and loopback, one socket
#   each, and never 0.0.0.0 — so there is no socket for a stranger to reach.
#
#   lan.OnlyLocal refuses any client whose address is not private, and refuses
#   a request that arrived under a Host this instance does not answer to. Nine
#   tests in internal/lan pin both.
#
# Allowing Cloudflare's ranges instead was considered and does not work: they
# change, and the nonce probe has to reach whatever anycast address the zone's
# hostnames resolve to today.

Restart=on-failure
RestartSec=5s
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
